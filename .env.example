# Local development only. Set a unique secret before any deployment.
DEBUG=1
DJANGO_SECRET_KEY=local-demo-only-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,backend
WEATHER_PROVIDER=sample
# Set open_meteo for credential-free live weather; needs api.open-meteo.com access.
DEMO_PASSWORD=FarmerDemo2026
# Docker PostgreSQL. Change before using real farmer data.
POSTGRES_DB=agri
POSTGRES_USER=agri
POSTGRES_PASSWORD=local-development-only
# Optional future integrations; not activated by setting credentials alone.
LLM_API_KEY=
VISION_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
